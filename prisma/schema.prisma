// Max Facility Operations (MFO) - Prisma Schema
// Ice Rink Management SaaS Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USER MANAGEMENT
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// User Roles Enum (6 Roles as per PRD)
enum UserRole {
  SUPER_ADMIN      // Platform-wide access
  FACILITY_ADMIN   // Full facility access, can use Form Builder
  MANAGER          // Department-level access
  SUPERVISOR       // Shift-level access
  ICE_TECHNICIAN   // Ice operations access
  STAFF            // Basic access
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  phone         String?
  role          UserRole  @default(STAFF)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  facilityUsers FacilityUser[]
  formSubmissions FormSubmission[]
  iceDepthReadings IceDepthReading[]
  incidentReports IncidentReport[]
  scheduleShifts ScheduleShift[]
  timeOffRequests TimeOffRequest[]
  notifications Notification[]
  auditLogs     AuditLog[]
  createdForms  FormTemplate[] @relation("FormCreator")
  notificationsSent NotificationLog[] @relation("NotificationSender")
  scheduledReportsCreated ScheduledReport[] @relation("ScheduledReportCreator")

  @@index([email])
  @@index([role])
}

// ============================================
// MULTI-TENANCY: ORGANIZATIONS & FACILITIES
// ============================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  address     String?
  city        String?
  state       String?
  postalCode  String?
  country     String   @default("US")
  phone       String?
  email       String?
  website     String?
  timezone    String   @default("America/New_York")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  facilities  Facility[]
  subscription Subscription?

  @@index([slug])
}

model Facility {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  slug            String
  address         String?
  city            String?
  state           String?
  postalCode      String?
  latitude        Float?
  longitude       Float?
  phone           String?
  email           String?
  timezone        String   @default("America/New_York")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rinks           Rink[]
  facilityUsers   FacilityUser[]
  formTemplates   FormTemplate[]
  formSubmissions FormSubmission[]
  incidentReports IncidentReport[]
  schedules       Schedule[]
  checklists      Checklist[]
  equipmentItems  Equipment[]
  alerts          Alert[]
  weatherCache    WeatherCache?
  notificationLogs NotificationLog[]
  scheduledReports ScheduledReport[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Rink {
  id              String   @id @default(cuid())
  facilityId      String
  name            String
  rinkType        RinkType @default(STANDARD)
  length          Float?   // in feet
  width           Float?   // in feet
  surfaceArea     Float?   // calculated sq ft
  icePointsConfig Int      @default(25)  // 25, 35, or 47 points
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  facility        Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  iceDepthReadings IceDepthReading[]
  iceMakeLogs     IceMakeLog[]
  zamboniLogs     ZamboniLog[]
  customDiagrams  CustomDiagram[]

  @@index([facilityId])
}

enum RinkType {
  STANDARD    // NHL size 200x85
  OLYMPIC     // Olympic size 200x100
  RECREATIONAL
  CURLING
  CUSTOM
}

// Custom Ice Depth Diagram Configuration
model CustomDiagram {
  id              String   @id @default(cuid())
  rinkId          String
  createdById     String

  name            String
  description     String?
  diagramType     RinkType @default(CUSTOM)

  // Dimensions
  length          Float    @default(200)  // in feet
  width           Float    @default(85)   // in feet

  // Point configuration stored as JSON
  // Array of { pointId, x, y, label }
  pointsConfig    Json

  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  rink            Rink     @relation(fields: [rinkId], references: [id], onDelete: Cascade)

  @@index([rinkId])
  @@index([createdById])
}

// Junction table for User-Facility access
model FacilityUser {
  id         String   @id @default(cuid())
  userId     String
  facilityId String
  role       UserRole // Role within this specific facility
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([userId, facilityId])
  @@index([userId])
  @@index([facilityId])
}

// ============================================
// FORM BUILDER SYSTEM
// ============================================

enum FormCategory {
  ICE_OPERATIONS
  INCIDENT_REPORTING
  REFRIGERATION
  AIR_QUALITY
  FACILITY_CHECKLIST
  CUSTOM
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  EMAIL
  PHONE
  DROPDOWN
  MULTI_SELECT
  RADIO
  CHECKBOX
  TOGGLE
  DATE
  TIME
  DATETIME
  FILE_UPLOAD
  PHOTO
  SIGNATURE
  SECTION_HEADER
  INSTRUCTIONAL_TEXT
  BODY_DIAGRAM      // For incident reports
  RINK_DIAGRAM      // For ice depth (read-only in form)
}

model FormTemplate {
  id              String       @id @default(cuid())
  facilityId      String
  createdById     String
  name            String
  description     String?
  category        FormCategory
  isActive        Boolean      @default(true)
  isPublished     Boolean      @default(false)
  version         Int          @default(1)

  // Auto-populated header settings
  includeWeather  Boolean      @default(true)
  includeTimestamp Boolean     @default(true)
  includeUser     Boolean      @default(true)
  includeFacility Boolean      @default(true)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  facility        Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdBy       User         @relation("FormCreator", fields: [createdById], references: [id])
  fields          FormField[]
  submissions     FormSubmission[]
  recurringForms  RecurringForm[]
  formActions     FormAction[]

  @@index([facilityId])
  @@index([category])
}

model FormField {
  id              String    @id @default(cuid())
  formTemplateId  String
  fieldType       FieldType
  label           String
  placeholder     String?
  helpText        String?

  // Validation
  isRequired      Boolean   @default(false)
  minValue        Float?
  maxValue        Float?
  minLength       Int?
  maxLength       Int?
  pattern         String?   // Regex pattern

  // Options for dropdown, radio, multi-select
  options         Json?     // Array of { value, label }

  // Layout & Display
  orderIndex      Int
  sectionId       String?   // Group fields into sections
  width           String    @default("full") // full, half, third

  // Conditional Logic
  conditionalLogic Json?    // { showIf: { fieldId, operator, value } }

  // Default value
  defaultValue    String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  formTemplate    FormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  fieldResponses  FormFieldResponse[]

  @@index([formTemplateId])
  @@index([orderIndex])
}

model FormSubmission {
  id              String   @id @default(cuid())
  formTemplateId  String
  facilityId      String
  submittedById   String

  // Auto-populated header data
  submittedAt     DateTime @default(now())
  weatherData     Json?    // { temp, humidity, conditions }

  // Status
  status          SubmissionStatus @default(SUBMITTED)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNotes     String?

  // Metadata
  deviceInfo      Json?    // { userAgent, platform }
  ipAddress       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  formTemplate    FormTemplate @relation(fields: [formTemplateId], references: [id])
  facility        Facility     @relation(fields: [facilityId], references: [id])
  submittedBy     User         @relation(fields: [submittedById], references: [id])
  fieldResponses  FormFieldResponse[]
  attachments     Attachment[]

  @@index([formTemplateId])
  @@index([facilityId])
  @@index([submittedById])
  @@index([submittedAt])
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

model FormFieldResponse {
  id               String   @id @default(cuid())
  formSubmissionId String
  formFieldId      String
  value            String?  @db.Text
  numericValue     Float?
  booleanValue     Boolean?
  jsonValue        Json?    // For complex data like multi-select

  createdAt        DateTime @default(now())

  // Relations
  formSubmission   FormSubmission @relation(fields: [formSubmissionId], references: [id], onDelete: Cascade)
  formField        FormField      @relation(fields: [formFieldId], references: [id])

  @@index([formSubmissionId])
  @@index([formFieldId])
}

model Attachment {
  id               String   @id @default(cuid())
  formSubmissionId String?
  incidentReportId String?

  fileName         String
  fileType         String
  fileSize         Int
  storageUrl       String   // GCS URL
  thumbnailUrl     String?

  uploadedAt       DateTime @default(now())

  // Relations
  formSubmission   FormSubmission? @relation(fields: [formSubmissionId], references: [id], onDelete: Cascade)
  incidentReport   IncidentReport? @relation(fields: [incidentReportId], references: [id], onDelete: Cascade)

  @@index([formSubmissionId])
  @@index([incidentReportId])
}

// ============================================
// MODULE 1: ICE DEPTH MONITORING
// ============================================

model IceDepthReading {
  id              String   @id @default(cuid())
  rinkId          String
  recordedById    String

  // Reading configuration
  pointsConfig    Int      @default(25)  // 25, 35, or 47
  readingPoints   Json     // Array of { pointId, x, y, depth }

  // Analysis
  averageDepth    Float?
  minDepth        Float?
  maxDepth        Float?
  variance        Float?

  // Gemini AI Analysis (Phase 3)
  aiAnalysis      Json?    // { patterns, risks, recommendations }
  aiAnalyzedAt    DateTime?

  // Environmental conditions
  ambientTemp     Float?
  iceTemp         Float?
  humidity        Float?

  // Status
  status          ReadingStatus @default(RECORDED)
  notes           String?

  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  rink            Rink @relation(fields: [rinkId], references: [id], onDelete: Cascade)
  recordedBy      User @relation(fields: [recordedById], references: [id])

  @@index([rinkId])
  @@index([recordedAt])
}

enum ReadingStatus {
  RECORDED
  ANALYZED
  FLAGGED
  ARCHIVED
}

// ============================================
// MODULE 2: ICE OPERATIONS
// ============================================

model IceMakeLog {
  id              String   @id @default(cuid())
  rinkId          String
  loggedById      String

  startTime       DateTime
  endTime         DateTime?

  // Ice make details
  waterTemp       Float?
  floodCount      Int      @default(1)
  iceThickness    Float?   // inches added

  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rink            Rink     @relation(fields: [rinkId], references: [id], onDelete: Cascade)

  @@index([rinkId])
  @@index([startTime])
}

model ZamboniLog {
  id              String   @id @default(cuid())
  rinkId          String
  equipmentId     String
  operatorId      String

  // Circle check items
  checkTime       DateTime @default(now())
  oilLevel        CheckStatus @default(OK)
  waterLevel      CheckStatus @default(OK)
  bladesCondition CheckStatus @default(OK)
  towelCondition  CheckStatus @default(OK)
  tiresCondition  CheckStatus @default(OK)
  lightsWorking   Boolean     @default(true)
  hornWorking     Boolean     @default(true)

  // Usage
  hoursAtCheck    Float?
  fuelLevel       Float?   // percentage

  // Issues
  issuesFound     String?
  maintenanceNeeded Boolean @default(false)

  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rink            Rink      @relation(fields: [rinkId], references: [id])
  equipment       Equipment @relation(fields: [equipmentId], references: [id])

  @@index([rinkId])
  @@index([equipmentId])
  @@index([checkTime])
}

enum CheckStatus {
  OK
  LOW
  NEEDS_ATTENTION
  CRITICAL
}

model BladeChangeLog {
  id              String   @id @default(cuid())
  equipmentId     String
  changedById     String

  changeTime      DateTime @default(now())
  hoursOnOldBlade Float
  bladeType       String?
  reason          BladeChangeReason @default(SCHEDULED)

  notes           String?

  createdAt       DateTime @default(now())

  equipment       Equipment @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId])
  @@index([changeTime])
}

enum BladeChangeReason {
  SCHEDULED
  DAMAGE
  PERFORMANCE
  OTHER
}

// ============================================
// MODULE 3: INCIDENT REPORTING
// ============================================

enum SeverityLevel {
  MINOR       // First aid only
  MODERATE    // Medical attention needed
  SERIOUS     // Emergency services called
  CRITICAL    // Life-threatening
}

model IncidentReport {
  id              String        @id @default(cuid())
  facilityId      String
  reportedById    String

  // Incident details
  incidentTime    DateTime
  location        String
  incidentType    String
  description     String        @db.Text

  // Severity
  severityLevel   SeverityLevel @default(MINOR)
  ambulanceCalled Boolean       @default(false)

  // Injured party
  injuredName     String?
  injuredContact  String?
  injuredAge      Int?

  // Body diagram data
  bodyDiagramData Json?         // { injuries: [{ bodyPart, x, y, description }] }

  // Witnesses
  witnesses       Json?         // Array of { name, contact }

  // Follow-up
  status          IncidentStatus @default(OPEN)
  followUpNotes   String?
  resolvedAt      DateTime?

  // Notifications sent
  gmNotified      Boolean       @default(false)
  gmNotifiedAt    DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  facility        Facility      @relation(fields: [facilityId], references: [id])
  reportedBy      User          @relation(fields: [reportedById], references: [id])
  attachments     Attachment[]

  @@index([facilityId])
  @@index([incidentTime])
  @@index([severityLevel])
}

enum IncidentStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
  CLOSED
}

// ============================================
// MODULE 4: REFRIGERATION ROOM LOGS
// ============================================

model RefrigerationLog {
  id              String   @id @default(cuid())
  facilityId      String
  recordedById    String

  recordedAt      DateTime @default(now())

  // Compressor readings
  compressor1Suction Float?
  compressor1Discharge Float?
  compressor2Suction Float?
  compressor2Discharge Float?

  // Temperature readings
  brineSupply     Float?
  brineReturn     Float?
  condenserIn     Float?
  condenserOut    Float?

  // Other readings
  oilPressure     Float?
  oilLevel        CheckStatus?
  refrigerantLevel CheckStatus?

  // Alerts
  alarmsPresent   Boolean  @default(false)
  alarmDetails    String?

  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([facilityId])
  @@index([recordedAt])
}

// ============================================
// MODULE 5: AIR QUALITY MONITORING
// ============================================

model AirQualityLog {
  id              String   @id @default(cuid())
  facilityId      String
  recordedById    String
  location        String   // Specific location in facility

  recordedAt      DateTime @default(now())

  // Readings
  co2Level        Float?   // ppm
  temperature     Float?   // Fahrenheit
  humidity        Float?   // percentage
  coLevel         Float?   // Carbon monoxide ppm

  // Thresholds exceeded
  thresholdExceeded Boolean @default(false)
  alertSent       Boolean  @default(false)

  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([facilityId])
  @@index([recordedAt])
}

// ============================================
// MODULE 6: EMPLOYEE SCHEDULING
// ============================================

model Schedule {
  id              String   @id @default(cuid())
  facilityId      String
  name            String   // e.g., "Week of Dec 9"
  startDate       DateTime
  endDate         DateTime
  status          ScheduleStatus @default(DRAFT)
  publishedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facility        Facility       @relation(fields: [facilityId], references: [id])
  shifts          ScheduleShift[]
  templates       ShiftTemplate[]

  @@index([facilityId])
  @@index([startDate])
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ScheduleShift {
  id              String   @id @default(cuid())
  scheduleId      String
  userId          String

  shiftDate       DateTime
  startTime       DateTime
  endTime         DateTime

  position        String?  // Role/position for this shift
  notes           String?

  // Status
  status          ShiftStatus @default(SCHEDULED)
  clockInTime     DateTime?
  clockOutTime    DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schedule        Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id])

  @@index([scheduleId])
  @@index([userId])
  @@index([shiftDate])
}

enum ShiftStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

model ShiftTemplate {
  id              String   @id @default(cuid())
  scheduleId      String?
  facilityId      String
  name            String

  dayOfWeek       Int      // 0-6, Sunday = 0
  startTime       String   // "HH:mm"
  endTime         String   // "HH:mm"
  position        String?

  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schedule        Schedule? @relation(fields: [scheduleId], references: [id])

  @@index([facilityId])
}

model TimeOffRequest {
  id              String   @id @default(cuid())
  userId          String

  startDate       DateTime
  endDate         DateTime
  reason          String?

  status          TimeOffStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNotes     String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([startDate])
}

enum TimeOffStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

// ============================================
// MODULE 7: FACILITY CHECKLISTS / SOPs
// ============================================

enum ChecklistCategory {
  OPENING
  CLOSING
  SAFETY
  MAINTENANCE
  CLEANING
  CUSTOM
}

model Checklist {
  id              String           @id @default(cuid())
  facilityId      String
  name            String
  description     String?
  category        ChecklistCategory
  isActive        Boolean          @default(true)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  facility        Facility         @relation(fields: [facilityId], references: [id])
  items           ChecklistItem[]
  completions     ChecklistCompletion[]

  @@index([facilityId])
  @@index([category])
}

model ChecklistItem {
  id              String   @id @default(cuid())
  checklistId     String

  label           String
  description     String?
  orderIndex      Int
  isRequired      Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  checklist       Checklist           @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completionItems ChecklistCompletionItem[]

  @@index([checklistId])
  @@index([orderIndex])
}

model ChecklistCompletion {
  id              String   @id @default(cuid())
  checklistId     String
  completedById   String

  completedAt     DateTime @default(now())
  notes           String?

  createdAt       DateTime @default(now())

  checklist       Checklist              @relation(fields: [checklistId], references: [id])
  items           ChecklistCompletionItem[]

  @@index([checklistId])
  @@index([completedAt])
}

model ChecklistCompletionItem {
  id                     String   @id @default(cuid())
  checklistCompletionId  String
  checklistItemId        String

  isCompleted            Boolean  @default(false)
  completedAt            DateTime?
  notes                  String?

  checklistCompletion    ChecklistCompletion @relation(fields: [checklistCompletionId], references: [id], onDelete: Cascade)
  checklistItem          ChecklistItem       @relation(fields: [checklistItemId], references: [id])

  @@index([checklistCompletionId])
}

// ============================================
// EQUIPMENT MANAGEMENT
// ============================================

enum EquipmentType {
  ZAMBONI
  OLYMPIA
  EDGER
  COMPRESSOR
  DEHUMIDIFIER
  OTHER
}

model Equipment {
  id              String        @id @default(cuid())
  facilityId      String

  name            String
  equipmentType   EquipmentType
  manufacturer    String?
  model           String?
  serialNumber    String?

  purchaseDate    DateTime?
  warrantyExpires DateTime?

  // Usage tracking
  currentHours    Float         @default(0)
  lastServiceHours Float?
  nextServiceHours Float?

  isActive        Boolean       @default(true)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  facility        Facility      @relation(fields: [facilityId], references: [id])
  zamboniLogs     ZamboniLog[]
  bladeChanges    BladeChangeLog[]

  @@index([facilityId])
  @@index([equipmentType])
}

// ============================================
// NOTIFICATIONS & ALERTS
// ============================================

enum NotificationType {
  INFO
  WARNING
  ALERT
  INCIDENT
  SCHEDULE
  SYSTEM
}

model Notification {
  id              String           @id @default(cuid())
  userId          String

  type            NotificationType
  title           String
  message         String
  link            String?          // Deep link to related item

  isRead          Boolean          @default(false)
  readAt          DateTime?

  createdAt       DateTime         @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Alert {
  id              String   @id @default(cuid())
  facilityId      String

  alertType       String   // e.g., "CO2_HIGH", "ICE_THIN"
  severity        SeverityLevel
  message         String
  threshold       Float?
  actualValue     Float?

  isAcknowledged  Boolean  @default(false)
  acknowledgedById String?
  acknowledgedAt  DateTime?

  createdAt       DateTime @default(now())

  facility        Facility @relation(fields: [facilityId], references: [id])
  acknowledgments AlertAcknowledgment[]

  @@index([facilityId])
  @@index([isAcknowledged])
  @@index([createdAt])
}

// Log of sent notifications (email/SMS)
model NotificationLog {
  id              String   @id @default(cuid())
  facilityId      String
  sentBy          String?

  type            String   // INCIDENT, ICE_THIN, REFRIGERATION, AIR_QUALITY, CUSTOM
  severity        String   // INFO, WARNING, SERIOUS, CRITICAL
  message         String
  recipientCount  Int      @default(0)

  success         Boolean  @default(true)
  error           String?
  messageId       String?  // From email provider

  createdAt       DateTime @default(now())

  facility        Facility @relation(fields: [facilityId], references: [id])
  sentByUser      User?    @relation("NotificationSender", fields: [sentBy], references: [id])

  @@index([facilityId])
  @@index([type])
  @@index([createdAt])
}

// ============================================
// WEATHER INTEGRATION
// ============================================

model WeatherCache {
  id              String   @id @default(cuid())
  facilityId      String   @unique

  temperature     Float    // Fahrenheit
  humidity        Float    // Percentage
  conditions      String   // e.g., "Cloudy"
  icon            String?  // Weather icon code

  fetchedAt       DateTime @default(now())
  expiresAt       DateTime

  facility        Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// ============================================
// BILLING & SUBSCRIPTIONS
// ============================================

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

model Subscription {
  id               String             @id @default(cuid())
  organizationId   String             @unique

  tier             SubscriptionTier   @default(FREE)
  status           SubscriptionStatus @default(TRIALING)

  maxFacilities    Int                @default(1)
  maxUsersPerFacility Int             @default(5)

  trialEndsAt      DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?

  stripeCustomerId String?
  stripeSubscriptionId String?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ============================================
// AUDIT LOGGING
// ============================================

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?

  action          String   // e.g., "CREATE", "UPDATE", "DELETE"
  entityType      String   // e.g., "FormSubmission", "User"
  entityId        String

  oldValues       Json?
  newValues       Json?

  ipAddress       String?
  userAgent       String?

  createdAt       DateTime @default(now())

  user            User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================
// THRESHOLD CONFIGURATION
// ============================================

enum ThresholdModule {
  ICE_DEPTH
  REFRIGERATION
  AIR_QUALITY
}

model ThresholdConfig {
  id              String          @id @default(cuid())
  facilityId      String
  rinkId          String?         // Optional - for rink-specific thresholds (ice depth)

  module          ThresholdModule
  parameterName   String          // e.g., "ice_depth", "brine_temp", "co2_level"

  minValue        Float?          // Minimum acceptable value
  maxValue        Float?          // Maximum acceptable value
  warningMin      Float?          // Warning threshold (below this triggers warning)
  warningMax      Float?          // Warning threshold (above this triggers warning)

  alertEnabled    Boolean         @default(true)
  alertSeverity   SeverityLevel   @default(MODERATE)

  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([facilityId, rinkId, module, parameterName])
  @@index([facilityId])
  @@index([module])
}

// ============================================
// NOTIFICATION CONFIGURATION
// ============================================

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
  PUSH
}

model NotificationConfig {
  id              String              @id @default(cuid())
  facilityId      String

  module          ThresholdModule
  alertSeverity   SeverityLevel       // Which severity levels trigger this config

  // Recipients
  recipientRole   UserRole?           // Notify all users with this role
  recipientUserId String?             // Or specific user (e.g., GM)

  // Channels
  channels        NotificationChannel[] // Which channels to use

  // Settings
  isEnabled       Boolean             @default(true)
  requiresAck     Boolean             @default(false) // Critical alerts need acknowledgment

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([facilityId])
  @@index([module])
}

// Alert acknowledgment tracking
model AlertAcknowledgment {
  id              String   @id @default(cuid())
  alertId         String
  userId          String

  acknowledgedAt  DateTime @default(now())
  notes           String?

  alert           Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, userId])
  @@index([alertId])
  @@index([userId])
}

// Notification queue for async sending
model NotificationQueue {
  id              String              @id @default(cuid())
  facilityId      String

  recipientId     String              // User ID
  recipientEmail  String?
  recipientPhone  String?

  channel         NotificationChannel
  subject         String?
  message         String
  link            String?             // Deep link

  // Status
  status          NotificationQueueStatus @default(PENDING)
  scheduledFor    DateTime            @default(now())
  sentAt          DateTime?
  failedAt        DateTime?
  failureReason   String?
  retryCount      Int                 @default(0)

  // Reference
  alertId         String?
  relatedType     String?             // e.g., "incident", "ice_depth"
  relatedId       String?

  createdAt       DateTime            @default(now())

  @@index([status, scheduledFor])
  @@index([recipientId])
  @@index([facilityId])
}

enum NotificationQueueStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// User notification preferences
model UserNotificationPrefs {
  id              String   @id @default(cuid())
  userId          String   @unique

  // Quiet hours
  quietHoursEnabled Boolean @default(true)
  quietHoursStart   String  @default("22:00") // 10 PM
  quietHoursEnd     String  @default("06:00") // 6 AM

  // Daily digest
  dailyDigestEnabled Boolean @default(false)
  dailyDigestTime    String  @default("05:00") // 5 AM
  digestIncludeAlerts Boolean @default(true)
  digestIncludeForms  Boolean @default(true)
  digestIncludeIncidents Boolean @default(true)
  digestIncludeReadings Boolean @default(true)

  // Channel preferences
  emailEnabled    Boolean @default(true)
  smsEnabled      Boolean @default(false)
  pushEnabled     Boolean @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// ============================================
// FACILITY BRANDING
// ============================================

model FacilityBranding {
  id              String   @id @default(cuid())
  facilityId      String   @unique

  logoUrl         String?
  primaryColor    String?  @default("#0ea5e9") // Default blue
  secondaryColor  String?

  // Report settings
  reportHeaderText String?
  reportFooterText String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([facilityId])
}

// ============================================
// SHIFT SWAP REQUESTS
// ============================================

enum SwapStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
  EXPIRED
}

model ShiftSwapRequest {
  id              String     @id @default(cuid())
  requesterId     String     // User requesting the swap

  // Original shift (requester's shift to give away)
  originalShiftId String

  // Target shift (shift requester wants)
  targetShiftId   String?    // Can be null if just giving away
  targetUserId    String?    // User who owns target shift

  // Status
  status          SwapStatus @default(PENDING)

  // Manager approval
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNotes     String?

  // Request details
  reason          String?
  expiresAt       DateTime?  // Auto-expire if not acted upon

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([requesterId])
  @@index([originalShiftId])
  @@index([targetShiftId])
  @@index([status])
}

// ============================================
// RECURRING FORMS
// ============================================

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

model RecurringForm {
  id              String            @id @default(cuid())
  facilityId      String
  formTemplateId  String

  // Schedule
  frequency       RecurringFrequency
  daysOfWeek      Int[]             // 0-6, for weekly. Empty = every day
  dayOfMonth      Int?              // For monthly
  timeOfDay       String            @default("08:00") // When to assign

  // Assignment
  assignedRole    UserRole?         // Assign to all users with this role
  assignedUserId  String?           // Or specific user

  // Reminder settings
  reminderEnabled Boolean           @default(true)
  reminderMinutes Int               @default(60) // Minutes before deadline

  // Settings
  dueInHours      Int               @default(24) // Hours to complete
  isActive        Boolean           @default(true)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  formTemplate    FormTemplate      @relation(fields: [formTemplateId], references: [id])

  @@index([facilityId])
  @@index([formTemplateId])
  @@index([isActive])
}

// Form auto-actions (trigger on submission)
model FormAction {
  id              String   @id @default(cuid())
  formTemplateId  String

  // Trigger condition
  triggerFieldId  String   // Which field to watch
  triggerOperator String   // "less_than", "greater_than", "equals", etc.
  triggerValue    String   // Value to compare against

  // Action to take
  actionType      FormActionType
  actionConfig    Json?    // Additional config for the action

  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  formTemplate    FormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)

  @@index([formTemplateId])
}

enum FormActionType {
  CREATE_ALERT       // Create an alert
  SEND_NOTIFICATION  // Send immediate notification
  CREATE_TASK        // Create a maintenance task
  FLAG_SUBMISSION    // Flag the submission for review
}

// ============================================
// DATA RETENTION / ARCHIVAL
// ============================================

model DataRetentionPolicy {
  id              String   @id @default(cuid())
  facilityId      String   @unique

  // Retention periods in years
  incidentRetention Int    @default(5)  // Incidents kept 5 years
  readingsRetention Int    @default(1)  // Ice/refrigeration/air quality
  formsRetention    Int    @default(1)  // Form submissions
  auditRetention    Int    @default(2)  // Audit logs

  // Archive settings
  autoArchive       Boolean @default(true)
  archiveDay        Int     @default(1)  // Day of year to run archive

  lastArchiveRun    DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([facilityId])
}

// ============================================
// SCHEDULED REPORTS
// ============================================

enum ReportSchedule {
  DAILY
  WEEKLY
  MONTHLY
}

model ScheduledReport {
  id              String         @id @default(cuid())
  facilityId      String
  createdById     String

  // Report configuration
  name            String
  description     String?
  reportType      String         // e.g., "ice_depth", "incidents", "air_quality", etc.

  // Schedule
  schedule        ReportSchedule
  dayOfWeek       Int?           // 0-6 for weekly reports
  dayOfMonth      Int?           // 1-31 for monthly reports
  timeOfDay       String         @default("06:00") // When to generate/send

  // Export settings
  exportFormat    String         @default("csv") // "csv" or "json"
  includeCharts   Boolean        @default(false)

  // Email delivery
  recipients      String[]       // Email addresses
  emailSubject    String?
  emailBody       String?

  // Filters
  dateRangeDays   Int            @default(7)  // Days of data to include

  // Status
  isActive        Boolean        @default(true)
  lastRunAt       DateTime?
  lastRunStatus   String?        // "success" or "failed"
  lastRunError    String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  facility        Facility       @relation(fields: [facilityId], references: [id])
  createdBy       User           @relation("ScheduledReportCreator", fields: [createdById], references: [id])
  history         ReportHistory[]

  @@index([facilityId])
  @@index([isActive, schedule])
  @@index([createdById])
}

model ReportHistory {
  id                String          @id @default(cuid())
  scheduledReportId String

  generatedAt       DateTime        @default(now())
  status            String          // "success", "failed"
  errorMessage      String?

  // Storage (URL or inline data reference)
  fileUrl           String?
  fileSize          Int?
  recordCount       Int?

  // Delivery
  emailsSent        Int             @default(0)
  emailsFailed      Int             @default(0)

  scheduledReport   ScheduledReport @relation(fields: [scheduledReportId], references: [id], onDelete: Cascade)

  @@index([scheduledReportId])
  @@index([generatedAt])
}

// ============================================
// ENTERPRISE / ORGANIZATION SETTINGS
// ============================================

model OrganizationSettings {
  id              String   @id @default(cuid())
  organizationId  String   @unique

  // Branding
  primaryColor    String?  @default("#0ea5e9")
  secondaryColor  String?
  logoUrl         String?
  faviconUrl      String?

  // Default thresholds for new facilities
  defaultIceDepthMin    Float?   @default(0.75)
  defaultIceDepthMax    Float?   @default(1.25)
  defaultCO2Threshold   Int?     @default(1000)
  defaultCOThreshold    Float?   @default(25)

  // Feature toggles
  enableScheduling      Boolean  @default(true)
  enableIncidents       Boolean  @default(true)
  enableForms           Boolean  @default(true)
  enableReports         Boolean  @default(true)
  enableAirQuality      Boolean  @default(true)
  enableRefrigeration   Boolean  @default(true)

  // Security settings
  requireMFA            Boolean  @default(false)
  sessionTimeoutMinutes Int      @default(480)  // 8 hours
  passwordMinLength     Int      @default(8)
  passwordRequireSpecial Boolean @default(false)

  // Data retention
  auditLogRetentionDays  Int     @default(365)
  incidentRetentionYears Int     @default(5)
  readingsRetentionDays  Int     @default(365)

  // Notification defaults
  defaultEmailNotifications Boolean @default(true)
  defaultSMSNotifications   Boolean @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

// Facility groups for organizing facilities
model FacilityGroup {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  color           String?  // For UI display

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facilities      FacilityGroupMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model FacilityGroupMember {
  id              String   @id @default(cuid())
  facilityGroupId String
  facilityId      String

  createdAt       DateTime @default(now())

  facilityGroup   FacilityGroup @relation(fields: [facilityGroupId], references: [id], onDelete: Cascade)

  @@unique([facilityGroupId, facilityId])
  @@index([facilityId])
}
