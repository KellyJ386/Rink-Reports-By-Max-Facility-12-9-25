# Database (Cloud SQL for PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/mfo_database?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# Google OAuth (via Firebase Auth)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OpenWeather API (for form headers)
OPENWEATHER_API_KEY="your-openweather-api-key"

# Google Cloud Storage (for file uploads)
GCS_BUCKET_NAME="mfo-attachments"
GCS_PROJECT_ID="your-gcp-project-id"
GOOGLE_APPLICATION_CREDENTIALS="path/to/service-account.json"

# Resend/SendGrid (for email notifications)
RESEND_API_KEY="your-resend-api-key"
SENDGRID_API_KEY="your-sendgrid-api-key"

# Twilio (for SMS notifications - incident alerts)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Gemini AI (via Vertex AI)
GEMINI_API_KEY="your-gemini-api-key"
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="us-central1"
